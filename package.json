{
  "name": "@featureflip/browser",
  "version": "2.11.1",
  "description": "Browser SDK for Featureflip - framework-agnostic feature flag client",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "featureflip",
    "browser",
    "javascript",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/canopy-labs/featureflip-browser.git"
  },
  "homepage": "https://featureflip.io/docs/sdks/browser/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "lodash": ">=4.17.25"
  }
}
