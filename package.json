{
  "name": "@featureflip/browser",
  "version": "1.0.0",
  "description": "Browser SDK for Featureflip - framework-agnostic feature flag client",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://featureflip.io/docs",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.2"
  }
}
